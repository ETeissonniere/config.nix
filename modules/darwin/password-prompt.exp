# macOS password tools read from a terminal, not stdin. Never log the PTY:
# even an unexpected child error or terminal echo must not disclose the input.
log_user 0
exp_internal 0
log_file
set timeout 120
set password [read stdin]
if {[string index $password end] eq "\n"} {
    set password [string range $password 0 end-1]
}
if {$password eq "" || [regexp {[[:cntrl:]]} $password]} {
    puts stderr "Expected a nonempty password without terminal control characters on stdin."
    exit 1
}

spawn -noecho {*}$argv
set prompts 0
expect {
    -re {(?i)(destination password: |password data for new item: |retype password for new item: )} {
        incr prompts
        if {$prompts > 2} {
            puts stderr "Password command repeated its prompt."
            exit 1
        }
        send -- "$password\r"
        exp_continue
    }
    timeout {
        puts stderr "Password command timed out."
        exit 1
    }
    eof {}
}
set result [wait]
if {[lindex $result 2] != 0 || [llength $result] > 4 || [lindex $result 3] != 0 || $prompts == 0} {
    puts stderr "Password command failed; check Keychain access, NAS connectivity, and Full Disk Access."
    exit 1
}
